# Server-side secrets
OPENAI_API_KEY=your_openai_api_key_here
RESEND_API_KEY=your_resend_api_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Public configuration used by the frontend build
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# Leave blank on Netlify so the app uses the same-origin /api routes.
# For local development, point this to your running backend if needed.
VITE_API_BASE_URL=

# Contact routing
CONTACT_TO_EMAIL=hello@zaraderagroup.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
