# Server-side secrets
OPENAI_API_KEY=your_openai_api_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=righthome_proptech

# SMTP delivery for Nodemailer
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=help@righthomeproptech.com
SMTP_PASSWORD=your_smtp_password_here

# Optional public configuration used by the frontend build
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Contact routing
CONTACT_TO_EMAIL=hello@zaraderagroup.com
# Must be an address authorized by your SMTP provider.
CONTACT_FROM_EMAIL=RightHome Proptech <no-reply@righthomeproptech.com>
