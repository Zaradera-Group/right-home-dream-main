# Server-side secrets
OPENAI_API_KEY=your_openai_api_key_here
RESEND_API_KEY=your_resend_api_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Optional public configuration used by the frontend build
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Contact routing
CONTACT_TO_EMAIL=hello@zaraderagroup.com
# Must use an address on the domain already verified in Resend.
CONTACT_FROM_EMAIL=website@your-verified-domain.com
